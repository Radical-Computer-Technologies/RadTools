{
  "components": [
    {
      "commands": [
        "radbuild",
        "build_vivado",
        "build_petalinux",
        "build_litex",
        "radsetup"
      ],
      "dependencies": {
        "arch": [
          "bash",
          "ca-certificates",
          "git",
          "openssh",
          "python",
          "rsync",
          "tar"
        ],
        "debian": [
          "bash",
          "ca-certificates",
          "git",
          "openssh-client",
          "python3",
          "rsync",
          "tar"
        ],
        "fedora": [
          "bash",
          "ca-certificates",
          "git",
          "openssh-clients",
          "python3",
          "rsync",
          "tar"
        ],
        "rhel": [
          "bash",
          "ca-certificates",
          "git",
          "openssh-clients",
          "python3",
          "rsync",
          "tar"
        ],
        "ubuntu": [
          "bash",
          "ca-certificates",
          "git",
          "openssh-client",
          "python3",
          "rsync",
          "tar"
        ]
      },
      "docs": "radbuild-server/v1.0.1/docs",
      "id": "radbuild-tools",
      "name": "RadBuild Tools",
      "payload": "radbuild-server/v1.0.1/payload",
      "platforms": [
        "linux-x86_64"
      ],
      "required": true,
      "root_subdir": "RadBuild",
      "template_dir": "radbuild-server/v1.0.1/templates",
      "version": "v1.0.1"
    },
    {
      "commands": [
        "radclient"
      ],
      "default": false,
      "dependencies": {
        "arch": [
          "bash",
          "ca-certificates",
          "python"
        ],
        "debian": [
          "bash",
          "ca-certificates",
          "python3"
        ],
        "fedora": [
          "bash",
          "ca-certificates",
          "python3"
        ],
        "rhel": [
          "bash",
          "ca-certificates",
          "python3"
        ],
        "ubuntu": [
          "bash",
          "ca-certificates",
          "python3"
        ]
      },
      "id": "radbuild-client",
      "name": "RadBuild Client",
      "payload": "radbuild-server/v1.0.1/payload",
      "platforms": [
        "linux-x86_64"
      ],
      "requires": [
        "radbuild-tools"
      ],
      "root_subdir": "RadBuild",
      "template_dir": "radbuild-server/v1.0.1/templates",
      "version": "v1.0.1"
    },
    {
      "commands": [
        "radserver",
        "raddb",
        "radbuildserver",
        "radworker",
        "radcodex_worker",
        "radllm"
      ],
      "config_templates": [
        {
          "dst": "radserver_data/server_config.json",
          "mode": "0600",
          "src": "server_config.json"
        },
        {
          "dst": "radserver_data/radbuildserver.json",
          "mode": "0644",
          "src": "radbuildserver.json"
        }
      ],
      "default": false,
      "dependencies": {
        "arch": [
          "bash",
          "python"
        ],
        "debian": [
          "bash",
          "python3"
        ],
        "fedora": [
          "bash",
          "python3"
        ],
        "rhel": [
          "bash",
          "python3"
        ],
        "ubuntu": [
          "bash",
          "python3"
        ]
      },
      "id": "radbuild-server",
      "name": "RadBuild Server and Workers",
      "payload": "radbuild-server/v1.0.1/payload",
      "platforms": [
        "linux-x86_64"
      ],
      "requires": [
        "radbuild-tools"
      ],
      "root_subdir": "RadBuild",
      "runtime_dirs": [
        "radserver_data/uploaded_logs"
      ],
      "template_dir": "radbuild-server/v1.0.1/templates",
      "version": "v1.0.1"
    },
    {
      "default": false,
      "dependencies": {
        "arch": [
          "systemd"
        ],
        "debian": [
          "systemd"
        ],
        "fedora": [
          "systemd"
        ],
        "rhel": [
          "systemd"
        ],
        "ubuntu": [
          "systemd"
        ]
      },
      "id": "radbuild-service",
      "name": "RadBuild Server systemd Service",
      "platforms": [
        "linux-x86_64"
      ],
      "requires": [
        "radbuild-server"
      ],
      "service": {
        "host": "0.0.0.0",
        "name": "radbuild-server",
        "port": "8767",
        "template": "radbuild-server/v1.0.1/templates/radbuild-server.service"
      },
      "version": "v1.0.1"
    },
    {
      "commands": [
        "radfpga_debug_hub",
        "radfpga_debug_hubd"
      ],
      "default": false,
      "dependencies": {
        "debian": [
          "libqt5widgets5",
          "libqt5network5",
          "libqt5serialport5"
        ],
        "ubuntu": [
          "libqt5widgets5",
          "libqt5network5",
          "libqt5serialport5"
        ]
      },
      "id": "radfpga-debug-hub",
      "name": "RadFPGA Debug Hub",
      "payload": "radfpga-debug-hub/v0.1.0/payload",
      "platforms": [
        "linux-x86_64"
      ],
      "root_subdir": "RadFPGA-Debug-Hub",
      "version": "v0.1.0"
    }
  ],
  "defaults": {
    "bindir": "/usr/bin",
    "install_root": "/opt/radtools",
    "systemd_dir": "/etc/systemd/system"
  },
  "release": {
    "codename": "Crimson",
    "name": "RadTools",
    "platform": "linux-x86_64",
    "version": "v1.0.1"
  }
}
